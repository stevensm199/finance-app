PORT=3000
LOG_LEVEL=debug

# Supabase local or cloud
SUPABASE_URL=http://127.0.0.1:55431
SUPABASE_SERVICE_ROLE_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_API_TIMEOUT_MS=10000

# Private bot-to-API authentication
BOT_API_BASE_URL=http://127.0.0.1:3000
BOT_SERVICE_TOKEN=
BOT_API_TIMEOUT_MS=10000

# Language model provider
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=15000

# Audio transcription (Groq Whisper)
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_MS=60000
AUDIO_MAX_DURATION_SECONDS=30
AUDIO_MAX_SIZE_BYTES=20000000
AUDIO_SUPPORTED_FORMATS=flac,mp3,mp4,mpeg,mpga,m4a,ogg,wav,webm
AUDIO_NO_SPEECH_THRESHOLD=0.6
AUDIO_MAX_ATTEMPTS=3
AUDIO_QUEUE_POLL_INTERVAL_MS=1000
AUDIO_JOB_RETENTION_HOURS=168

# Transaction parsing and presentation
TRANSACTION_CUES=spent,paid,bought,earned,received,gaste,pagué,compre,gané,recibí,transferí
TRANSACTION_PROMPT_FILE=config/prompts/transaction-extraction.es.txt
MESSAGES_FILE=config/messages.es.json
CURRENCY=COP
LOCALE=es-CO
TIME_ZONE=America/Bogota
PAGE_DEFAULT_SIZE=20
PAGE_MAX_SIZE=100
